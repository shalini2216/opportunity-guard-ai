# OpportunityGuard AI Environment Configuration
# Copy this file to .env and populate with your credentials

# Flask Application Secret
SECRET_KEY=change-this-in-production-to-a-secure-random-token-64-chars
JWT_SECRET_KEY=change-this-jwt-secret-to-a-secure-random-token-64-chars

# MongoDB Database Connection
MONGO_URI=mongodb://127.0.0.1:27017/opportunity_guard
DB_NAME=opportunity_guard

# Google Gemini API Key (Optional: system automatically uses deterministic NLP fallback if empty)
GEMINI_API_KEY=

# Gmail OAuth 2.0 Credentials (Optional: use Demo Mode for interactive evaluation without credentials)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5000/api/email/oauth/callback

# Server Port
PORT=5000
